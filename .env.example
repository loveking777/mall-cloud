# 复制为 .env 后 docker compose 会自动读取
#
# 本地开发可以直接用这个默认值；
# 生产环境务必换成随机密钥，并且用户服务和网关必须保持一致。
#
# 生成方式（PowerShell）：
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
MALL_JWT_SECRET_BASE64=ZGV2LW9ubHktc2VjcmV0LWtleS0zMi1ieXRlcy1sb25nISE=
